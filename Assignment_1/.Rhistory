e21 <- 600*628/1100
e22 <- 472*600/1100
#2. Sum of (observed - expected)^2 / expected
o11 <- (309 - e11)^2/e11
o12 <- (191 - e12)^2/e12
o21 <- (319 - e21)^2/e21
o22 <- (281 - e22)^2 / e22
(chisquared <- o11 + o12 + o21 + o22)
#1. sum of observed*log(observed/expected)
l11 <- 309*log(309/e11)
l12 <- 191*log(191/e12)
l21 <- 319*log(319/e21)
l22 <- 281*log(281/e22)
(G2 <- 2*(l11+l12+l21+l22))
#1. Calculate odds for males, females and odd ratio
OddsM = 319/281
OddsF = 309/191
(OR=OddsF/OddsM)
#2. Estimate Standard Error
SE_lor <- sqrt((1/309)+(1/191)+(1/319)+(1/281))
#3. Take the logarithm of OR
LOR <- log(OR)
#3. Confidence Intervals
(LB <- exp(LOR - 1.96*SE_lor))
(UB <- exp(LOR + 1.96*SE_lor))
#1. Calculate Risk Ratio
piF <- 309/500
piM <- 319/600
(RR <- piF/piM)
#2. Estimate Standard Error
SE2 <- sqrt(((1-piF)/309)+((1-piM)/319))
#3. Take the logarithm of RR
LRR <- log(RR)
#4. Confidence Intervals
(UB2 <- exp(LRR + 1.96*SE2))
(LB2 <- exp(LRR - 1.96*SE2))
kable(D,
row.names = TRUE,
col.names = c("Female", "Male"),
digits = 4)
tab1<- as.table(rbind(c(309, 191), c(319, 281)))
dimnames(tab1) <- list(gender = c("women", "men"),opinion = c("favor","against"))
addmargins(tab1)
addmargins(prop.table(tab1,1),2)
F <- cbind(c(G2, chisquared))
rownames(F) <- c("Likelihood Ratio Statistic", "Chi-Squared Statistic")
kable(F,
row.names = TRUE,
digits = 4)
chisq.test(tab1,correct=FALSE)
library(MASS) # the MASS package must have been installed
loglm(~gender+opinion,tab1)
# The function loglm fits a loglinear model, but we leave the details about that.
# Loglinear models will be handled in assignment 3 but with the function glm instead of loglm.
T <- rbind(c(OR, LB, UB), c(RR, LB2, UB2))
rownames(T) <- c("Odds Ratio", "Risk Ratio")
kable(T,
row.names = TRUE,
col.names = c("Point Estimation", "CI Lower Bound", "CI Upper Bound"),
digit = 4)
library(epitools) # the epitools package must have been installed
oddsratio(tab1, method = "wald", rev="both")$measure
riskratio(tab1,rev="both")$measure
tab2<- as.table(rbind(c(1198, 1493), c(557, 1278)))
dimnames(tab2) <- list(gender = c("Men", "Women"),admission = c("Admitted","Rejected"))
